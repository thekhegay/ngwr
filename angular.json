{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "lib": {
      "projectType": "library",
      "root": "projects/lib",
      "sourceRoot": "projects/lib",
      "prefix": "wr",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/lib/tsconfig.lib.json",
            "outputPath": "dist/lib",
            "assets": [
              {
                "glob": "**/*.scss",
                "input": "projects/lib",
                "output": "."
              },
              {
                "glob": "README.md",
                "input": ".",
                "output": "."
              },
              {
                "glob": "LICENSE",
                "input": ".",
                "output": "."
              }
            ]
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/lib/tsconfig.lib.prod.json",
              "compilationMode": "partial"
            },
            "development": {
              "tsConfig": "projects/lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/lib/**/*.ts",
              "projects/lib/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "tsConfig": "projects/lib/tsconfig.spec.json",
            "buildTarget": "lib:build:development",
            "include": [
              "**/*.spec.ts",
              "../showcase/**/*.spec.ts"
            ],
            "setupFiles": [
              "projects/lib/vitest-setup.ts"
            ]
          }
        }
      }
    },
    "showcase": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/showcase",
      "sourceRoot": "projects/showcase",
      "prefix": "ngwr",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/showcase",
              "browser": "",
              "media": "assets"
            },
            "index": "projects/showcase/index.html",
            "browser": "projects/showcase/main.ts",
            "server": "projects/showcase/main.server.ts",
            "outputMode": "static",
            "polyfills": [],
            "tsConfig": "projects/showcase/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/showcase/public"
              },
              {
                "glob": "{llms.txt,llms-full.txt}",
                "input": ".",
                "output": "."
              },
              {
                "glob": "skills/**/*.md",
                "input": ".",
                "output": "."
              }
            ],
            "styles": [
              "projects/showcase/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects"
              ]
            },
            "scripts": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "extractLicenses": false,
              "sourceMap": false,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": {
                "scripts": false,
                "styles": {
                  "minify": false,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "showcase:build:production"
            },
            "development": {
              "buildTarget": "showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/showcase/**/*.ts",
              "projects/showcase/**/*.html"
            ]
          }
        }
      }
    },
    "ngwr-v15": {
      "projectType": "application",
      "root": "projects/ngwr-v15",
      "sourceRoot": "projects/ngwr-v15",
      "prefix": "sbx",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ngwr-v15/main.ts",
            "index": "projects/ngwr-v15/index.html",
            "tsConfig": "projects/ngwr-v15/tsconfig.app.json",
            "polyfills": [],
            "styles": [
              "projects/ngwr-v15/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngwr-v15:build:production"
            },
            "development": {
              "buildTarget": "ngwr-v15:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngwr-v15/**/*.ts",
              "projects/ngwr-v15/**/*.html"
            ]
          }
        }
      }
    },
    "sandbox": {
      "projectType": "application",
      "root": "projects/sandbox",
      "sourceRoot": "projects/sandbox",
      "prefix": "sb",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sandbox/main.ts",
            "index": "projects/sandbox/index.html",
            "tsConfig": "projects/sandbox/tsconfig.app.json",
            "polyfills": [],
            "styles": [
              "projects/sandbox/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sandbox:build:production"
            },
            "development": {
              "buildTarget": "sandbox:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
