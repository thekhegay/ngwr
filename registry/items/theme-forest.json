{
  "$schema": "https://ngwr.dev/registry/schema.json",
  "name": "theme-forest",
  "type": "registry:theme",
  "title": "Forest",
  "description": "A deep green primary with a muted teal info, for dashboards that read as calm rather than alert.",
  "author": "ngwr",
  "ngwr": ">=11",
  "cssVars": {
    "light": {
      "--wr-color-primary": "#1f6b45",
      "--wr-color-primary-rgb": "31, 107, 69",
      "--wr-color-primary-contrast": "#ffffff",
      "--wr-color-primary-dark": "#195738",
      "--wr-color-primary-darker": "#14432b",
      "--wr-color-primary-light": "#257f52",
      "--wr-color-primary-lighter": "#2a935f",
      "--wr-color-info": "#2b6b74",
      "--wr-color-info-rgb": "43, 107, 116",
      "--wr-color-info-contrast": "#ffffff",
      "--wr-color-info-dark": "#245a61",
      "--wr-color-info-darker": "#1d494f",
      "--wr-color-info-light": "#327c87",
      "--wr-color-info-lighter": "#398d99"
