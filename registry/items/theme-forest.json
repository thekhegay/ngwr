      "--wr-color-primary-rgb": "95, 185, 138",
      "--wr-color-primary-contrast": "#000000",
      "--wr-color-primary-dark": "#4db17d",
      "--wr-color-primary-darker": "#469f71",
      "--wr-color-primary-light": "#71c197",
      "--wr-color-primary-lighter": "#82c9a4",
      "--wr-color-info": "#6cb3bc",
      "--wr-color-info-rgb": "108, 179, 188",
      "--wr-color-info-contrast": "#000000",
      "--wr-color-info-dark": "#5aaab4",
      "--wr-color-info-darker": "#4d9ea8",
      "--wr-color-info-light": "#7ebcc4",
      "--wr-color-info-lighter": "#8fc5cc"
