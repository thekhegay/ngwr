{
  "name": "ngwr-workspace",
  "version": "0.0.0-NOT-USED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --o",
    "test": "ng test lib",
    "test:watch": "ng test lib --watch",
    "lint": "ng lint && eslint scripts && pnpm lint:styles && pnpm check:colors",
    "check:colors": "tsx scripts/check-color-parity.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
  "check:contrast": "tsx scripts/check-contrast.ts",
    "gen:api-docs": "tsx scripts/gen-api-docs.ts",
    "check:llms": "tsx scripts/gen-ai-assets.ts --check",
    "check:api-docs": "tsx scripts/gen-api-docs.ts --check",
    "lint:styles": "stylelint \"projects/**/*.scss\"",
    "build:lib": "ng build lib && tsx scripts/gen-ai-assets.ts && tsx scripts/copy-dist-assets.ts && tsx scripts/gen-i18n-json.ts && tsx scripts/build-schematics.ts",
    "build:showcase": "tsx scripts/gen-ai-assets.ts && tsx scripts/build-showcase.ts && tsx scripts/gen-sitemap.ts && tsx scripts/gen-md-docs.ts",
    "icons:sets": "node scripts/build-icon-sets.mjs",
    "postinstall": "node scripts/build-icon-sets.mjs",
    "release:prepare": "tsx scripts/release-prepare.ts",
    "release:body": "tsx scripts/release-body.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no-install commitlint --edit $1"
  },
  "engines": {
    "node": "^24.16.0 || >=26.0.0",
    "pnpm": "^11.10.0"
  },
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "ngx-mask": "^22.1.0",
    "rxjs": "~7.8.2",
    "shiki": "^4.4.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.3",
    "@angular-devkit/schematics": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@schematics/angular": "^22.1.3",
    "@tabler/icons": "^3.46.0",
    "@types/jsdom": "^28.0.3",
    "@types/luxon": "^3.7.3",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "angular-eslint": "^22.1.0",
    "axe-core": "^4.13.0",
    "bootstrap-icons": "^1.13.1",
    "conventional-changelog": "^8.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "date-fns": "^4.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "feather-icons": "^4.29.2",
    "heroicons": "^2.2.0",
    "iconoir": "^7.11.1",
    "jsdom": "^30.0.1",
    "lucide": "^1.29.0",
    "luxon": "^3.7.2",
    "ng-packagr": "^22.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "tsx": "^4.23.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
