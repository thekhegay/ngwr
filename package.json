{
  "name": "ngwr-workspace",
  "version": "0.0.0-NOT-USED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --o",
    "test": "ng test lib",
    "test:coverage": "ng test lib --coverage --coverage-reporters lcovonly text-summary",
    "test:watch": "ng test lib --watch",
    "lint": "ng lint && eslint scripts && pnpm lint:styles && pnpm check:rtl && pnpm check:tokens && pnpm check:selectors && pnpm check:attrs && pnpm check:install",
    "check:nightly": "pnpm build:showcase && pnpm check:a11y && pnpm check:contrast && pnpm check:state-a11y && pnpm check:layout && pnpm check:rtl-layout",
    "check:release": "pnpm lint && pnpm test && pnpm check:api-docs && pnpm check:css-vars && pnpm build:lib && pnpm check:package && pnpm check:nightly",
    "check:package": "tsx scripts/check/package.ts",
    "check:layout": "tsx scripts/check/layout.ts",
    "check:nav": "tsx scripts/check/nav.ts",
    "check:a11y": "tsx scripts/check/a11y.ts",
    "check:contrast": "tsx scripts/check/contrast.ts",
    "gen:api-docs": "tsx scripts/gen/api-docs.ts",
    "gen:selectors": "tsx scripts/gen/selectors.ts",
    "gen:css-vars": "tsx scripts/gen/css-vars.ts",
    "gen:install": "tsx scripts/gen/install.ts",
    "gen:deps": "tsx scripts/gen/deps.ts",
    "check:install": "tsx scripts/gen/install.ts --check",
    "gen:exports": "tsx scripts/gen/exports.ts",
    "check:css-vars": "tsx scripts/gen/css-vars.ts --check",
    "check:attrs": "tsx scripts/check/unknown-attrs.ts",
    "check:selectors": "tsx scripts/gen/selectors.ts --check",
    "gen:quality": "tsx scripts/gen/quality.ts",
    "check:api-docs": "tsx scripts/gen/api-docs.ts --check",
    "lint:styles": "stylelint \"projects/**/*.scss\"",
    "build:lib": "tsx scripts/build/lib.ts",
    "build:showcase": "tsx scripts/build/showcase.ts",
    "icons:sets": "node scripts/build/icon-sets.mjs",
    "postinstall": "node scripts/build/icon-sets.mjs",
    "release:prepare": "tsx scripts/release/prepare.ts",
    "release:body": "tsx scripts/release/body.ts",
    "release:check": "tsx scripts/release/check.ts",
    "prepare": "simple-git-hooks",
    "check:state-a11y": "tsx scripts/check/state-a11y.ts",
    "check:tokens": "tsx scripts/check/tokens.ts",
    "check:rtl": "tsx scripts/check/rtl.ts",
    "check:rtl-layout": "tsx scripts/check/rtl-layout.ts"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no-install commitlint --edit $1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "pnpm": "^12.16.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.3 || ^24.15.0 || ^26.0.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/ssr": "^22.2.6",
    "ngx-mask": "^22.2.5",
    "rxjs": "~7.8.2",
    "shiki": "^4.6.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.6",
    "@angular-devkit/schematics": "^22.2.6",
    "@angular/build": "^22.3.0-next.5",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@schematics/angular": "^22.2.6",
    "@tabler/icons": "^3.51.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "^22.6.0",
    "axe-core": "^4.14.0",
    "bootstrap-icons": "^1.13.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "feather-icons": "^4.29.2",
    "heroicons": "^2.2.0",
    "iconoir": "^7.12.2",
    "jsdom": "^31.0.0",
    "lucide": "^1.71.0",
    "ngtrue": "^0.3.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "semver": "^7.8.6",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
