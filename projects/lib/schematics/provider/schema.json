{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ngwr-provider",
  "title": "ngwr provider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "enum": ["icons", "toast", "i18n", "density", "storage"],
      "description": "Provider to add.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": {
        "message": "Which provider?",
        "type": "list",
        "items": [
          {
            "value": "icons",
            "label": "icons — register a tree-shaken icon set"
          },
          {
            "value": "toast",
            "label": "toast — withToast() in provideWr(): global toast defaults"
          },
          {
            "value": "i18n",
            "label": "i18n — Transloco-class translation core"
          },
          {
            "value": "density",
            "label": "density — withDensity() in provideWr(): sm / md / lg scale"
          },
          {
            "value": "storage",
            "label": "storage — withStorage() in provideWr(): swappable engine + TTL"
          }
        ]
      }
    },
    "path": {
      "type": "string",
      "format": "path",
      "description": "Main entry file to patch. Defaults to the first match in `src/main.ts`."
    },
    "project": {
      "type": "string",
      "description": "Target Angular project.",
      "$default": {
        "$source": "projectName"
      }
    }
  },
  "required": ["name"]
}
