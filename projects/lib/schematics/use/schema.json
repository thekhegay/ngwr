{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ngwr-use",
  "title": "ngwr use",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Class name to import — e.g. `WrButton`, `WrSelect`, `WrFormField`.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "Class name to import (e.g. WrButton)?"
    },
    "path": {
      "type": "string",
      "format": "path",
      "description": "Component file to edit. Named option, not positional. When omitted, the schematic prints a copy-pasteable snippet instead of editing a file."
    },
    "project": {
      "type": "string",
      "description": "Target Angular project. Defaults to the workspace default.",
      "$default": {
        "$source": "projectName"
      }
    }
  },
  "required": ["symbol"]
}
