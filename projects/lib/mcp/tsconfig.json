{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "outDir": "../../../dist/lib/mcp",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
